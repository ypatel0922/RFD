NEXT_PUBLIC_SUPABASE_URL=https://qdiktqcpwahtfhrvlncd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_RECEIPTS_BUCKET=receipts

# Server-only. Used by app/api/extract-receipt and by statement reconciliation.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4o-mini

# Monthly bank-statement reconciliation (server-side API routes).
# Statement page images are sent to OpenAI to be read and are never stored by
# Hallix. Defaults to gpt-4.1 (stronger than the receipt model) because statement
# pages are dense multi-column tables. Override if your account needs a different pin.
BANK_STATEMENT_VISION_MODEL=gpt-4.1
# Days a bank posting date may differ from the Hallix date and still match.
RECONCILIATION_DATE_TOLERANCE_DAYS=7
# How closely the statement's vendor name must resemble the recorded one (0.3-0.95).
RECONCILIATION_VENDOR_MATCH_MIN_SIMILARITY=0.62
# Percentage a card charge may exceed the recorded amount and still be offered
# as a possible match, covering a tip written on the receipt by hand.
RECONCILIATION_TIP_TOLERANCE_PERCENT=30

# Plaid (server-side API routes)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for department invite verification and marking department setup complete (server API routes).

# Request Demo form (server-only API route at app/api/request-demo).
RESEND_API_KEY=
DEMO_REQUEST_TO_EMAIL=

# Twilio SMS/MMS receipt collection (server-side API routes).
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use Messaging Service SID (starts with MG) for sender pool, or a single number (starts with +1...)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Public URL of this deployment, used in SMS links and Twilio webhook signature validation.
# Example: https://app.firebook.app
APP_BASE_URL=
