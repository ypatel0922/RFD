SUPABASE_URL=https://qdiktqcpwahtfhrvlncd.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_RECEIPTS_BUCKET=receipts
RFD_SESSION_SECRET=replace-with-a-long-random-secret

# Next.js frontend equivalents. These are used by frontend/.env.local.
NEXT_PUBLIC_SUPABASE_URL=https://qdiktqcpwahtfhrvlncd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_RECEIPTS_BUCKET=receipts

# Optional: enables automatic receipt field extraction and monthly bank-statement
# reconciliation. Server-side only — never expose this to the browser.
OPENAI_API_KEY=

# Optional: vision model used to read bank-statement pages. Defaults to gpt-4.1
# (stronger than the receipt model). Must support image input and structured
# (JSON schema) output.
BANK_STATEMENT_VISION_MODEL=gpt-4.1

# Optional: how many days a bank posting date may differ from the date recorded
# in Hallix and still be considered a match. Defaults to 7, capped at 45.
RECONCILIATION_DATE_TOLERANCE_DAYS=

# Optional: how closely the vendor name on the statement must resemble the name
# recorded in Hallix, from 0.3 (loose) to 0.95 (near-identical). Defaults to 0.62.
RECONCILIATION_VENDOR_MATCH_MIN_SIMILARITY=

# Optional: how much larger a card charge may be than the recorded amount and
# still be offered as a possible match, to allow for a tip written on a receipt
# after it was printed. A percentage. Defaults to 30, capped at $150 of overage.
RECONCILIATION_TIP_TOLERANCE_PERCENT=
